server_tokens off;

# Catch-all: drop requests with unknown Host (IP scans, junk domains).
# Certbot will inject its own TLS blocks; this only handles port 80.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
        allow all;
    }

    return 444;
}

server {
    listen 80;
    listen [::]:80;
    server_name {{ nginx_server_name }};

    server_tokens off;

    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log;

    # Certbot HTTP-01 must always pass through.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
        allow all;
    }

    # Scanner drops: never proxy these to Node. 444 closes the
    # connection with no response, so bots get nothing back.
    # Keep this above `location /`. Hits are logged to scanners.log
    # (not dropped silently) so Fail2ban can ban repeat offenders.
    location ~* ^/(wp-|wp/|wordpress|xmlrpc\.php|phpmyadmin|phpMyAdmin|pma|adminer|mysql|dbadmin|actuator|console/|_ignition|vendor/phpunit|laravel|server-status|cgi-bin/|shell|config\.|\.aws|credentials) {
        access_log /var/log/nginx/scanners.log;
        log_not_found off;
        return 444;
    }

    # Dotfile / secret-file probes anywhere in the path.
    location ~* /\.(env|git|svn|hg|htaccess|htpasswd|DS_Store) {
        access_log /var/log/nginx/scanners.log;
        log_not_found off;
        return 444;
    }

    # The app is Node-only: there are no legit .php/.asp/.cgi endpoints.
    # NOTE: nginx strips the query string before location matching,
    # so /wp-login.php?x=1 is seen as /wp-login.php ($ matches).
    location ~* \.(php|asp|aspx|cgi|pl)(/|$) {
        access_log /var/log/nginx/scanners.log;
        log_not_found off;
        return 444;
    }

    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name {{ grafana_server_name }};

    server_tokens off;

    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
        allow all;
    }

    location ~* ^/(wp-|wp/|wordpress|xmlrpc\.php|phpmyadmin|phpMyAdmin|pma|adminer|mysql|dbadmin|actuator|console/|_ignition|vendor/phpunit|laravel|server-status|cgi-bin/|shell|config\.|\.aws|credentials) {
        access_log /var/log/nginx/scanners.log;
        log_not_found off;
        return 444;
    }

    location ~* /\.(env|git|svn|hg|htaccess|htpasswd|DS_Store) {
        access_log /var/log/nginx/scanners.log;
        log_not_found off;
        return 444;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
